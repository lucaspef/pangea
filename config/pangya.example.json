// Modelo da configuração. Copie para config/pangya.json (tools/setup-dev.sh faz isso e gera a senha do banco).
{
  // Portas de desenvolvimento (não colidem com o emulador Python em 80/10101/20201).
  // Num servidor de verdade: Web 80, Login 10101, Game 20201.
  "Run": ["web", "login", "game"],
  "Game": { "Id": 30201, "Name": "PangYa C#", "Port": 30201, "MaxUsers": 1000, "Channels": [ { "Name": "Canal 1", "MaxUsers": 100 } ] },
  "Web": { "Port": 30080, "AutoRegister": false },
  "Login": { "Ports": [30101], "ServerUid": 10101 },
  "Network": {
    "BindIp": "0.0.0.0",
    "PublicIp": "127.0.0.1"
  },
  "Database": {
    "ConnectionString": "Host=127.0.0.1;Port=5432;Database=pangya;Username=pangya;Password=CHANGE_ME"
  },
  "Logging": {
    "Level": "Info",
    "Dir": "logs"
  },
  "Data": {
    "IffPath": "data/pangya.iff"
  },
  "Lottery": {
    "PapelPrice": 900,
    "PapelBallWeights": [35, 30, 20, 10, 5],
    "ScratchCountWeights": [30, 69, 1]
  },
  "Limits": {
    "MaxConnectionsPerIp": 10,
    "MaxPacketsPerSecond": 100,
    "MaxPacketSize": 8192,
    "MaxLoginAttemptsPerMinute": 10,
    "IdleTimeoutSeconds": 120
  }
}
