// Configuração usada pelos testes automáticos (banco pangya_test, apagado e recriado a cada execução).
{
  "Network": {
    "BindIp": "127.0.0.1",
    "PublicIp": "127.0.0.1"
  },
  "Database": {
    "ConnectionString": "Host=127.0.0.1;Port=5432;Database=pangya_test;Username=pangya;Password=CHANGE_ME"
  },
  "Limits": {
    "MaxConnectionsPerIp": 50,
    "MaxPacketsPerSecond": 1000,
    "MaxPacketSize": 8192,
    "MaxLoginAttemptsPerMinute": 1000,
    "IdleTimeoutSeconds": 120
  }
}
